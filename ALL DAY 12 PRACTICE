import random

# Constants for number of attempts based on difficulty
EASY_LEVEL_TURNS = 10
HARD_LEVEL_TURNS = 5

# Function to set difficulty level
def set_difficulty():
    difficulty_choice = input("Choose a difficulty. Type 'easy' or 'hard': ").lower()
    if difficulty_choice == "easy":
        return EASY_LEVEL_TURNS
    else:
        return HARD_LEVEL_TURNS

# Function to check the user's guess
def check_guess(guess, random_number, turns_left):
    if guess < random_number:
        print("Your guess is too low!")
        return turns_left - 1
    elif guess > random_number:
        print("Your guess is too high!")
        return turns_left - 1
    else:
        print(f"Congratulations! You guessed the right number: {random_number}")
        return 0

# Main game function
def play_game():
    print("Welcome to the Number Guessing Game!")
    random_number = random.randint(1, 100)  # Step 1: Generate random number
    print("I'm thinking of a number between 1 and 100.")
    
    # Step 2: Set the difficulty
    attempts = set_difficulty()
    guess = 0
    
    while attempts > 0 and guess != random_number:
        # Step 3: Get user input
        guess = int(input(f"You have {attempts} attempts remaining. Make a guess: "))
        
        # Step 4: Check the guess and reduce attempts
        attempts = check_guess(guess, random_number, attempts)
    
    # Step 5: End of game messages
    if guess == random_number:
        print("You've won the game!")
    else:
        print(f"Sorry, you've run out of attempts. The correct number was {random_number}.")
    
    print("Game Over! Thank you for playing.")  # Final message after game ends

# Run the game
play_game()
